{
  "name": "operationcode",
  "license": "MIT",
  "version": "2.0.15",
  "scripts": {
    "build": "next build",
    "build:analyze": "cross-env ANALYZE=true next build",
    "chromatic": "chromatic --exit-zero-on-changes",
    "dev": "next -p 3000",
    "format": "prettier --write \"**/*\"",
    "format:md": "prettier --write \"**/*.md\"",
    "lint": "pnpm lint:scripts && pnpm format:md",
    "lint:ci": "eslint .",
    "lint:scripts": "eslint --fix src",
    "postbuild": "next-sitemap --config next-sitemap.config.ts",
    "prepare": "husky",
    "start": "next start -p 3000",
    "storybook": "storybook dev -p 6006 -c src/.storybook",
    "storybook:build": "storybook build -c src/.storybook",
    "test:e2e": "export LOCAL_PLAYWRIGHT=true && playwright test --headed",
    "test:e2e:debug": "pnpm test:e2e --debug",
    "test:e2e:dev": "export LOCAL_PLAYWRIGHT=true && playwright test --ui",
    "test:e2e:headless": "playwright test",
    "test:e2e:headless:agent": "PLAYWRIGHT_HTML_OPEN=never && playwright test",
    "test:e2e:update-snaps": "playwright test --update-snapshots",
    "test": "vitest --run",
    "test:ci": "pnpm test --coverage --silent",
    "test:changes": "pnpm test --changed main",
    "test:changes:watch": "pnpm test:changes --watch",
    "test:update-snaps": "pnpm test -u",
    "test:ui": "vitest --ui",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "vitest": "cross-env vitest --config ./vitest.config.mts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@hookform/resolvers": "^5.9.2",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/bundle-analyzer": "^16.4.2",
    "@next/mdx": "^16.4.2",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-tabs": "1.2.1",
    "@sentry/nextjs": "^11.8.0",
    "@types/mdx": "^2.0.14",
    "airtable": "^0.12.2",
    "axios": "^1.20.0",
    "cva": "1.0.0-beta.8",
    "fast-xml-parser": "^5.11.2",
    "fingerprintjs2": "^2.1.4",
    "fontfaceobserver": "^2.3.0",
    "lodash": "^4.18.1",
    "logrocket": "^12.4.0",
    "logrocket-react": "^7.0.1",
    "lucide-react": "^1.59.0",
    "next": "^16.4.2",
    "next-sitemap": "^4.2.3",
    "object-hash": "^3.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.90.0",
    "react-player": "^3.4.0",
    "react-select": "^5.10.2",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.28.1",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.6.0",
    "@next/eslint-plugin-next": "^16.4.2",
    "@playwright/test": "^1.64.1",
    "@storybook/addon-docs": "^10.6.2",
    "@storybook/nextjs": "^10.6.2",
    "@svgr/webpack": "^8.1.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/fingerprintjs2": "^2.0.0",
    "@types/fontfaceobserver": "^2.1.3",
    "@types/lodash": "^4.17.26",
    "@types/node": "^26.6.5",
    "@types/object-hash": "^3.0.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vitest/ui": "^5.0.5",
    "axios-mock-adapter": "^2.1.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "chromatic": "^18.13.0",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.8",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-better-tailwindcss": "^4.9.1",
