    "eslint-plugin-no-barrel-files": "^2.2.0",
    "eslint-plugin-playwright": "^2.12.1",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-you-might-not-need-an-effect": "^1.0.2",
    "eslint-plugin-storybook": "^10.6.2",
    "eslint-plugin-unicorn": "^78.0.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "17.6.0",
    "postcss": "^8.5.14",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn": "^4.22.1",
    "storybook": "^10.6.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.0.12",
    "vite-plugin-magical-svg": "^1.10.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.5",
    "webpack": "^5.112.0"
  },
  "packageManager": "pnpm@12.15.0+sha512.b3951d6d6ff4a9f13dc7cf56cd28d2b8eb37dbcc9c68e52e1e1191873ea9f82a017287ab50baadc5ccc494f036c67c0e47eb13608c2fa36f47711b61ea128e61"
}
