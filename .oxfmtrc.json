{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "arrowParens": "always",
  "printWidth": 100,
  "semi": true,
  "singleQuote": true,
  "trailingComma": "all",
  "sortPackageJson": false,
  "sortTailwindcss": {
    "stylesheet": "./src/lib/styles/globals.css",
    "functions": ["cx"]
  },
  "ignorePatterns": [
    "node_modules",
    "package.json",
    "pnpm-lock.yaml",
    "next-env.d.ts",
    ".next",
    ".github",
    "bin",
    "static",
    "cypress-coverage",
    "vitest-coverage",
    ".storybook-dist",
    "**/*.snap",
    "**/*.mp4",
    "**/*.png",
    "**/*.jpeg",
    "**/*.jpg",
    "**/*.txt",
    "**/*.xml",
    "**/*.ico",
    "**/*.mdx"
  ],
  "sortImports": {
    "groups": ["builtin", "external", "internal", "parent", "sibling", "index"],
    "newlinesBetween": false
  }
}
